# Copy to .env.local and fill in. Nothing here is a secret: these are addresses and a
# publishable key, and they end up in the page. Secrets live in the Convex and Clerk dashboards.
#
# With neither value set the app runs entirely in the browser on the sample world.

# The address of the Convex deployment. `npx convex dev` writes this (and CONVEX_DEPLOYMENT)
# into .env.local by itself; for a production build, take it from the Convex dashboard.
VITE_CONVEX_URL=

# Clerk's publishable key, from the Clerk dashboard under "API keys". Accounts are switched on
# only when this and VITE_CONVEX_URL are both set.
VITE_CLERK_PUBLISHABLE_KEY=

# Set on the Convex deployment, not here:
#
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN <the issuer of Clerk's "convex" JWT template>
#
# Functions cannot be pushed until it is set. In Clerk, the JWT template must be named "convex".
#
#   npx convex env set PANDASCORE_TOKEN <token from the PandaScore dashboard>
#
# Without it, real data is chess only. This one is a secret: it belongs on the deployment and
# nowhere else.
#
#   npx convex env set LOLESPORTS_KEY <the key lolesports.com sends with its own requests>
#
# Optional. Without it a League game shows who won and how long it took, and nothing from inside.
# The feed is unofficial; see docs/DATA-SOURCES.md before switching it on.

# Files whose names carry a fingerprint of their contents never change: kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The chess pieces change with a release at most.
/pieces/*
  Cache-Control: public, max-age=2592000

# The app is not meant to be shown inside another site's page, and asks for nothing of the
# device it runs on.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
